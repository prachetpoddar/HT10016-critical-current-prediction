__pycache__/
*.pyc
.DS_Store
_to_delete/

# working backups the edit scripts used to write; git is the backup
*.pre_label_fit

# Credential-shaped files, so a stray one cannot be committed by accident.
# Nothing of this kind has ever been in this repository; the entries are here
# to keep it that way, since the repository is public and history is forever.
.env
.env.*
.envrc
.netrc
credentials
credentials.*
secrets
secrets.*
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519
.npmrc
.pypirc
service_account*.json

# Intermediate revisions of the three documents. The lineage ran to fifty-two
# stages, each writing a full set, and the .docx snapshots reached 113 MB of a
# 156 MB repository without carrying anything a reader needs: every stage is in
# the git history, and the submitted set is tracked in out_final52/. Untracked
# here rather than deleted, so a local working tree keeps them.
out/
out_*/
!out_final52/
